# 复制本文件为 .env 后填入自己的配置：cp .env.example .env
# 支持所有 OpenAI 兼容接口（OpenAI / DeepSeek / Moonshot / 通义千问 / 智谱 / vLLM / Ollama）

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL；若结尾不是 /v1、/v2 等版本号，程序会自动补 /v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名
LLM_MODEL=gpt-4o-mini

# 可选参数（不填则用下面的默认值）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
